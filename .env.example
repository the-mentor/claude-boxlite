# Claude auth — pick ONE:
CLAUDE_CODE_OAUTH_TOKEN=   # subscription; get via `claude setup-token`
# ANTHROPIC_API_KEY=       # API key alternative
# ANTHROPIC_BASE_URL=      # optional: point at a gateway/proxy
# ANTHROPIC_AUTH_TOKEN=    # optional
# ANTHROPIC_MODEL=         # optional

# GitHub (optional) — enables gh + git push/pull over HTTPS
# GH_TOKEN=

# Git identity (optional)
# GIT_AUTHOR_NAME=
# GIT_AUTHOR_EMAIL=
